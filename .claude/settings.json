{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make help)",
      "Bash(make fmt)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make types)",
      "Bash(make doc)",
      "Bash(make ci)",
      "Bash(make msrv)",
      "Bash(make coverage)",
      "Bash(make bless)",
      "Bash(make quickstart)",
      "Bash(make walkthrough)",
      "Bash(make site)",
      "Bash(make ui)",
      "Bash(make ui-check)",
      "Bash(make e2e)",
      "Bash(make console)",
      "Bash(make all)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo doc *)",
      "Bash(cargo run *)",
      "Bash(cargo fetch *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo llvm-cov *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm --prefix website ci *)",
      "Bash(npm --prefix website run *)",
      "Bash(npm --prefix console ci *)",
      "Bash(npm --prefix console run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(python3 scripts/*)",
      "Bash(python3 -m doctest scripts/*)",
      "Bash(sh examples/quickstart/run.sh *)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)"
    ],
    "ask": [
      "Bash(*oracle jev*)",
      "Bash(*oracle=jev*)",
      "Bash(*jev-check*)",
      "Bash(*doctor --network*)",
      "Bash(*glm-claude.sh*)",
      "Bash(*claude-agent.sh*)",
      "Bash(*run_episode.py*)",
      "Bash(*run_pilot.py*)",
      "Bash(*run_paired.py*)",
      "Bash(*run_trials.py*)",
      "Bash(*run_procedure.py*)",
      "Bash(*run_bench_*)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * -f)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push --tags *)",
      "Bash(git push * --tags)",
      "Bash(git push * v*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.stretto/**/*key*)",
      "Read(//tmp/stretto-jev-*)",
      "Read(~/.glm-claude/**)",
      "Read(~/.claude-agent/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(git push *--force* main)",
      "Bash(git push *--force* *:main)",
      "Bash(git push * main --force*)",
      "Bash(git push -f * main)",
      "Bash(git push -f * *:main)",
      "Bash(git push * main -f)",
      "Bash(git push * +main)",
      "Bash(git push * +*:main)",
      "Bash(git push * :main)",
      "Bash(git push *--delete* main)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .)",
      "Bash(cargo publish *)",
      "Bash(cargo login *)",
      "Bash(cargo owner *)",
      "Bash(cargo yank *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-rust.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
