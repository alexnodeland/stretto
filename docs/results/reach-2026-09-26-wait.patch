+    /// A model of the agent's next call: at each step, the first action from
+    /// that step on that is not `respond`. A reply is a step but not a
+    /// decision, since it returns no tool result, so this is the call a
+    /// lookup made now must answer if no later decision is to make it.
+    pub fn fit_next_call(
+        order: usize,
+        alpha: f64,
+        vocab_size: usize,
+        episodes: &[EncodedEpisode],
+        respond: u32,
+    ) -> Self {
+        let mut m = Self::new(order, alpha, vocab_size);
+        for ep in episodes {
+            for t in 0..ep.actions.len() {
+                let next = ep.actions[t..].iter().copied().find(|&a| a != respond);
+                m.observe_set(&ep.symbols[..t], next);
+            }
+        }
+        m
+    }
